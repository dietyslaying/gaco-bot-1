# Telegram bot
BOT_TOKEN=
FILES_GROUP_ID=-1001540419890
REQUEST_GROUP_ID=-1001440080728
REQUEST_GROUP_URL=https://t.me/+your-invite
ADMINS=123456789

# Database — use Postgres on Railway (always-on). SQLite only for local tests.
# Railway: attach Postgres plugin → copy DATABASE_URL
DATABASE_URL=postgresql://user:pass@host:5432/gaco
REDIS_URL=

# --- Catalogue (classic dual buttons, no LLM) ---
CATALOG_ENABLED=true
CATALOG_REPLY_TEXT=Here you go!
CATALOG_GACO_BUTTON=✨ GACO ✨
CATALOG_DOWNLOAD_BUTTON=⛩ DOWNLOAD ⛩
CATALOG_DOWNLOAD_URL=
CATALOG_USE_STICKERS=true
CATALOG_QUALITY_PRIORITY=1080p,2160p,4k,720p,hdrip,480p,360p

# --- Cover Server (admin USER session — full forum topic access) ---
# 1) https://my.telegram.org → api_id / api_hash
# 2) python scripts/login_session.py → TELEGRAM_SESSION
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Chat the bot can message to upload stickers (defaults to first ADMIN)
COVER_STORAGE_CHAT_ID=

CATALOG_BACKFILL_DELAY=0.35
CATALOG_BACKFILL_LIMIT=0
